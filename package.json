{
  "name": "easynewtab",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Chrome new tab page rebuilt as a VS Code-style IDE shell",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test tests/",
    "render-check": "node scripts/render-check.mjs",
    "icons": "node scripts/make-app-icons.mjs",
    "preview:mobile": "npm run build && node scripts/mobile-preview.mjs",
    "check": "npm run typecheck && npm test && npm run render-check",
    "verify": "npm run check && npm run build"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.2.1",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^3.0.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/server-renderer": "^3.5.43",
    "typescript": "^5.9.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
