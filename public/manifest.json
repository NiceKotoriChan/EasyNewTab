{
  "manifest_version": 3,
  "name": "EasyNewTab",
  "version": "1.0.8",
  "description": "New tab page built as an IDE-style shell: bookmark tree, history and web search.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["bookmarks", "history", "storage", "favicon", "topSites"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
